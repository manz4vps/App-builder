<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin untuk bikin garis pinggir (Handle) ngambang di layar -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Izin untuk manggil Shizuku -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:allowBackup="true"
        android:label="Smart Sidebar">
        
        <!-- Layar Utama cuma buat tombol "Start Service" & Minta Izin -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service yang jalan di background (Sidebar-nya) -->
        <service android:name=".SidebarService" android:exported="false" />
    </application>
</manifest>
